<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        Title="Settings"
        Height="340" Width="460"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Appearance" FontWeight="Bold" Margin="0,0,0,4"/>
            <CheckBox Name="DarkModeCheck" Content="Dark mode"/>
        </StackPanel>

        <Separator Grid.Row="1"/>

        <StackPanel Grid.Row="2">
            <TextBlock Text="CMS redundancy" FontWeight="Bold" Margin="0,0,0,4"/>
            <CheckBox Name="CmsSnapshotCheck"
                      Content="Snapshot CMS server list and use it as fallback if CMS is unreachable"/>
            <TextBlock Name="SnapshotInfo" Text="" Foreground="#666666" FontSize="11" Margin="20,4,0,0"/>
        </StackPanel>

        <Separator Grid.Row="3"/>

        <StackPanel Grid.Row="4">
            <TextBlock Text="Logs" FontWeight="Bold" Margin="0,0,0,4"/>
            <TextBlock Name="LogPathText" Text="" Foreground="#666666" FontSize="11"/>
        </StackPanel>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Name="SaveBtn"   Content="Save"   Width="80" Margin="0,0,4,0"/>
            <Button Name="CancelBtn" Content="Cancel" Width="80"/>
        </StackPanel>
    </Grid>
</Window>
